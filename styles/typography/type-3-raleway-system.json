{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Raleway headings, system text",
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--raleway)"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--raleway)"
				}
			}
		}
	}
}
