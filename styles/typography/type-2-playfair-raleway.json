{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Playfair Display headings, Raleway text",
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--raleway)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair)"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--raleway)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair)"
				}
			}
		}
	}
}
