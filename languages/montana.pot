#. Theme Name of the theme
#: style.css
msgid "Montana"
msgstr ""

#. Theme URI of the theme
#: style.css
msgid "https://colorlib.com/wp/themes/montana/"
msgstr ""

#. Description of the theme
#: style.css
msgid "A block theme for hotels, lodges and mountain resorts. A full-screen photograph slider, offers, a video band, the restaurant, four featured rooms, a rooms page with each room's price and facts, and a room booking request form that needs no plugin -- check-in and check-out dates, guests and room, checked on the server and emailed to the front desk. Contact and newsletter forms too, eight colour palettes, five type pairings, visitor dark mode and WooCommerce styling. Full site editing throughout."
msgstr ""

